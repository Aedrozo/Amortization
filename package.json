{
  "name": "gem-home-team-mortgage-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Mortgage amortization, extra-payment and refinance calculator suite for Gem Home Team Mortgage Lending.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "build": "node build.mjs",
    "test": "node --test tests/finance.test.mjs",
    "test:ui": "node --test --test-timeout=900000 tests/ui.test.mjs",
    "test:dist": "node build.mjs && BASE_URL=http://localhost:8080/dist/index.html node --test --test-timeout=900000 tests/ui.test.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:dist",
    "build:logo": "node tools/build-logo.mjs"
  },
  "keywords": [
    "mortgage",
    "amortization",
    "refinance",
    "calculator"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "opentype.js": "^2.0.0",
    "playwright": "^1.62.1"
  }
}
